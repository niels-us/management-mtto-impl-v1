{
  "name": "maintenance-api-impl-v1",
  "version": "1.0.0",
  "description": "Arquetipo template basado en typescript - api rest",
  "scripts": {
    "build": "npm run typecheck && swc src -d dist --strip-leading-paths",
    "build:dev": "swc src -d dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "set IS_AUTH_IAM=true && npm run build && serverless offline start --stage DESA --param=\"functionsFile=local\" --httpPort 3001",
    "start:docker": "node dist/maintenances/infrastructure/bootstrap/App.js",
    "test": "jest --coverage",
    "sls-deploy": "npm run build && serverless deploy --stage DESA --region us-east-1",
    "migrate-passwords-bcrypt": "node -r @swc-node/register scripts/migrate-passwords-bcrypt.ts",
    "docs": "echo 'API documentation available at: http://localhost:3000/dev/swagger'",
    "lint": "eslint src --ext .ts",
    "docker:build": "docker build -t maintenance-api:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:rebuild": "docker-compose up -d --build",
    "docker:restart": "docker-compose restart app",
    "docker:clean": "docker-compose down -v"
  },
  "author": "Kepler Srl",
  "license": "Copyright (c) Kepler Srl",
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "8.10.161",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "20.10.4",
    "@types/pg": "^8.12.0",
    "jest": "29.7.0",
    "jest-cucumber": "3.0.1",
    "nodemon": "^3.1.14",
    "prettier": "3.1.0",
    "serverless": "3.40.0",
    "serverless-offline": "13.8.3",
    "serverless-plugin-reducer": "4.0.1",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "@middy/core": "4.5.5",
    "@nestjs/common": "10.2.10",
    "@nestjs/core": "10.2.10",
    "@types/bcrypt": "6.0.0",
    "bcrypt": "6.0.0",
    "excel4node": "1.8.2",
    "groq-sdk": "^0.4.0",
    "joi": "17.11.0",
    "jsonwebtoken": "9.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "0.1.14",
    "rxjs": "7.8.1"
  }
}
